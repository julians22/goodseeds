{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "awcodes/filament-tiptap-editor": "^3.5.16",
        "bezhansalleh/filament-google-analytics": "^2.1.2",
        "codezero/laravel-localized-routes": "^4.0.1",
        "filament/filament": "^3.3.50",
        "filament/spatie-laravel-media-library-plugin": "3.0",
        "filament/spatie-laravel-settings-plugin": "^3.3.50",
        "guzzlehttp/guzzle": "^7.10",
        "laravel/framework": "^10.50.2",
        "laravel/sanctum": "^3.3.3",
        "laravel/tinker": "^2.11.1",
        "spatie/laravel-medialibrary": "^10.15",
        "spatie/laravel-sluggable": "^3.8.1",
        "spatie/laravel-translatable": "^6.11.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.56",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^7.12",
        "phpunit/phpunit": "^10.5.63",
        "spatie/laravel-ignition": "^2.9.1"
    },
    "autoload": {
        "files": [
            "app/Helpers/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "10.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "codezero/composer-preload-files": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
